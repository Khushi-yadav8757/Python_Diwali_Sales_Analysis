
# ============================================================
# DIWALI SALES ANALYSIS
# Python | Pandas | NumPy | Matplotlib | Seaborn
# ============================================================

# 1. IMPORT LIBRARIES
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

%matplotlib inline

sns.set_theme(style="whitegrid")


# 2. LOAD DATASET
# Keep the CSV file in the same folder as this notebook.
df = pd.read_csv(
    "Diwali Sales Data.csv",
    encoding="unicode_escape"
)

print("Dataset loaded successfully!")
print("Original dataset shape:", df.shape)

display(df.head())


# 3. EXPLORE THE DATASET
print("\nDataset information:")
df.info()

print("\nColumn names:")
print(df.columns.tolist())

print("\nMissing values:")
print(df.isnull().sum())

print("\nStatistical summary:")
display(df.describe())


# 4. DATA CLEANING
# Remove unrelated and completely empty columns.
df.drop(
    columns=["Status", "unnamed1"],
    errors="ignore",
    inplace=True
)

# Remove rows with missing Amount values.
df.dropna(subset=["Amount"], inplace=True)

# Convert Amount to integer.
df["Amount"] = df["Amount"].astype(int)

# Rename Marital_Status to Shaadi.
df.rename(
    columns={"Marital_Status": "Shaadi"},
    inplace=True
)

# Clean extra spaces in text columns.
text_columns = df.select_dtypes(include=["object"]).columns

for col in text_columns:
    df[col] = df[col].str.strip()

print("\nData cleaning completed!")
print("Cleaned dataset shape:", df.shape)

print("\nMissing values after cleaning:")
print(df.isnull().sum())

display(df.head())


# 5. DESCRIPTIVE STATISTICS
print("\nSummary of Age, Orders and Amount:")
display(df[["Age", "Orders", "Amount"]].describe())

print("\nTotal customers:", df["User_ID"].nunique())
print("Total orders:", df["Orders"].sum())
print("Total sales amount: ₹{:,.0f}".format(df["Amount"].sum()))
print("Average transaction amount: ₹{:,.2f}".format(df["Amount"].mean()))


# 6. GENDER ANALYSIS
print("\nGender-wise sales:")
gender_sales = (
    df.groupby("Gender")
    .agg(
        Customers=("User_ID", "nunique"),
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(gender_sales)

# Customer count by gender
plt.figure(figsize=(7, 5))
ax = sns.countplot(data=df, x="Gender", hue="Gender", legend=False)

for bars in ax.containers:
    ax.bar_label(bars)

plt.title("Customer Count by Gender")
plt.xlabel("Gender")
plt.ylabel("Number of Transactions")
plt.tight_layout()
plt.show()

# Sales by gender
plt.figure(figsize=(7, 5))
gender_sales["Sales"].plot(kind="bar")

plt.title("Total Sales by Gender")
plt.xlabel("Gender")
plt.ylabel("Sales Amount (₹)")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()


# 7. AGE GROUP ANALYSIS
print("\nAge-group analysis:")
age_sales = (
    df.groupby("Age Group")
    .agg(
        Customers=("User_ID", "nunique"),
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(age_sales)

# Transaction count by age group and gender
plt.figure(figsize=(10, 6))
ax = sns.countplot(
    data=df,
    x="Age Group",
    hue="Gender",
    order=sorted(df["Age Group"].dropna().unique())
)

for bars in ax.containers:
    ax.bar_label(bars)

plt.title("Age Group and Gender Distribution")
plt.xlabel("Age Group")
plt.ylabel("Number of Transactions")
plt.tight_layout()
plt.show()

# Sales by age group
plt.figure(figsize=(10, 6))
sns.barplot(
    data=df,
    x="Age Group",
    y="Amount",
    hue="Age Group",
    estimator=sum,
    errorbar=None
)

plt.title("Total Sales by Age Group")
plt.xlabel("Age Group")
plt.ylabel("Sales Amount (₹)")
plt.tight_layout()
plt.show()


# 8. STATE-WISE ANALYSIS
print("\nTop 10 states by sales:")
state_sales = (
    df.groupby("State")
    .agg(
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(state_sales.head(10))

# Top 10 states by sales
plt.figure(figsize=(12, 6))
top_states = state_sales.head(10).sort_values("Sales")

sns.barplot(
    x=top_states["Sales"],
    y=top_states.index
)

plt.title("Top 10 States by Sales")
plt.xlabel("Sales Amount (₹)")
plt.ylabel("State")
plt.tight_layout()
plt.show()

# Top 10 states by orders
plt.figure(figsize=(12, 6))
top_order_states = (
    state_sales.sort_values("Orders", ascending=False)
    .head(10)
    .sort_values("Orders")
)

sns.barplot(
    x=top_order_states["Orders"],
    y=top_order_states.index
)

plt.title("Top 10 States by Number of Orders")
plt.xlabel("Total Orders")
plt.ylabel("State")
plt.tight_layout()
plt.show()


# 9. MARITAL STATUS ANALYSIS
print("\nMarital-status analysis:")
marital_sales = (
    df.groupby("Shaadi")
    .agg(
        Customers=("User_ID", "nunique"),
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(marital_sales)

# Note: In this dataset, 0 and 1 represent coded marital-status values.
# Verify the dataset documentation before assigning labels.
plt.figure(figsize=(7, 5))
sns.barplot(
    data=marital_sales.reset_index(),
    x="Shaadi",
    y="Sales",
    hue="Shaadi",
    legend=False
)

plt.title("Total Sales by Marital Status Code")
plt.xlabel("Marital Status Code")
plt.ylabel("Sales Amount (₹)")
plt.tight_layout()
plt.show()


# 10. OCCUPATION ANALYSIS
print("\nTop occupations by sales:")
occupation_sales = (
    df.groupby("Occupation")
    .agg(
        Customers=("User_ID", "nunique"),
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(occupation_sales.head(10))

plt.figure(figsize=(12, 6))
top_occupations = occupation_sales.head(10).sort_values("Sales")

sns.barplot(
    x=top_occupations["Sales"],
    y=top_occupations.index
)

plt.title("Top 10 Occupations by Sales")
plt.xlabel("Sales Amount (₹)")
plt.ylabel("Occupation")
plt.tight_layout()
plt.show()


# 11. PRODUCT CATEGORY ANALYSIS
print("\nProduct-category analysis:")
category_sales = (
    df.groupby("Product_Category")
    .agg(
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(category_sales)

# Top 10 product categories by sales
plt.figure(figsize=(12, 6))
top_categories = category_sales.head(10).sort_values("Sales")

sns.barplot(
    x=top_categories["Sales"],
    y=top_categories.index
)

plt.title("Top 10 Product Categories by Sales")
plt.xlabel("Sales Amount (₹)")
plt.ylabel("Product Category")
plt.tight_layout()
plt.show()

# Sales share by product category
plt.figure(figsize=(10, 8))
category_sales["Sales"].sort_values(ascending=False).plot(
    kind="pie",
    autopct="%1.1f%%",
    startangle=90
)

plt.title("Product Category Sales Distribution")
plt.ylabel("")
plt.tight_layout()
plt.show()


# 12. ZONE-WISE ANALYSIS
print("\nZone-wise sales:")
zone_sales = (
    df.groupby("Zone")
    .agg(
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(zone_sales)

plt.figure(figsize=(9, 5))
sns.barplot(
    data=zone_sales.reset_index(),
    x="Zone",
    y="Sales",
    hue="Zone",
    legend=False
)

plt.title("Total Sales by Zone")
plt.xlabel("Zone")
plt.ylabel("Sales Amount (₹)")
plt.tight_layout()
plt.show()


# 13. TOP 10 PRODUCTS BY SALES
print("\nTop 10 products by sales:")
product_sales = (
    df.groupby("Product_ID")
    .agg(
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(product_sales.head(10))

top_products = product_sales.head(10).sort_values("Sales")

plt.figure(figsize=(12, 6))
sns.barplot(
    x=top_products["Sales"],
    y=top_products.index
)

plt.title("Top 10 Products by Sales Amount")
plt.xlabel("Sales Amount (₹)")
plt.ylabel("Product ID")
plt.tight_layout()
plt.show()


# 14. TOP 10 CUSTOMERS BY PURCHASE AMOUNT
print("\nTop 10 customers by purchase amount:")
customer_sales = (
    df.groupby(["User_ID", "Cust_name"])
    .agg(
        Orders=("Orders", "sum"),
        Sales=("Amount", "sum")
    )
    .sort_values("Sales", ascending=False)
)

display(customer_sales.head(10))


# 15. CORRELATION HEATMAP
numeric_columns = df.select_dtypes(include=np.number)

plt.figure(figsize=(10, 7))
sns.heatmap(
    numeric_columns.corr(),
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)

plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()


# 16. FINAL KEY BUSINESS METRICS
total_customers = df["User_ID"].nunique()
total_transactions = len(df)
total_orders = df["Orders"].sum()
total_sales = df["Amount"].sum()
average_amount = df["Amount"].mean()

print("\n" + "=" * 45)
print("       DIWALI SALES ANALYSIS SUMMARY")
print("=" * 45)

print(f"Unique Customers       : {total_customers:,}")
print(f"Total Transactions     : {total_transactions:,}")
print(f"Total Orders           : {total_orders:,}")
print(f"Total Sales Amount     : ₹{total_sales:,.0f}")
print(f"Average Transaction    : ₹{average_amount:,.2f}")

if not gender_sales.empty:
    print(
        "Highest Sales Gender   :",
        gender_sales["Sales"].idxmax()
    )

if not age_sales.empty:
    print(
        "Top Age Group by Sales :",
        age_sales["Sales"].idxmax()
    )

if not state_sales.empty:
    print(
        "Top State by Sales     :",
        state_sales["Sales"].idxmax()
    )

if not occupation_sales.empty:
    print(
        "Top Occupation         :",
        occupation_sales["Sales"].idxmax()
    )

if not category_sales.empty:
    print(
        "Top Product Category   :",
        category_sales["Sales"].idxmax()
    )

print("=" * 45)


# 17. EXPORT CLEANED DATASET
df.to_csv("Diwali_Sales_Cleaned.csv", index=False)

print("\nCleaned dataset saved as Diwali_Sales_Cleaned.csv")
print("Diwali Sales Analysis completed successfully!")
